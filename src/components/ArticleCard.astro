---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel, categoryStyles, formatDate, readingTime } from '@/lib/content';

interface Props {
  articulo: CollectionEntry<'articulos'>;
  featured?: boolean;
}

const { articulo, featured = false } = Astro.props;
const minutos = readingTime(articulo.body);
---

<a
  href={`/articulos/${articulo.slug}`}
  class={`group block rounded-xl border border-gray-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/40 dark:hover:border-gray-700 ${
    featured ? 'md:p-8' : ''
  }`}
>
  <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${categoryStyles(articulo.data.categoria)}`}>
    {categoryLabel(articulo.data.categoria)}
  </span>

  <h2 class={`mt-3 font-semibold text-gray-900 group-hover:text-cyan-600 dark:text-white dark:group-hover:text-cyan-400 ${featured ? 'text-2xl' : 'text-lg'}`}>
    {articulo.data.title}
  </h2>

  <p class={`mt-2 text-gray-600 dark:text-gray-400 ${featured ? 'text-base' : 'text-sm'}`}>{articulo.data.description}</p>

  <div class="mt-4 flex items-center gap-3 text-xs text-gray-400 dark:text-gray-500">
    <time datetime={articulo.data.pubDate.toISOString()}>{formatDate(articulo.data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutos} min de lectura</span>
  </div>
</a>
