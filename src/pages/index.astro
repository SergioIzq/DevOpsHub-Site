---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { categoryLabel } from '@/lib/content';

const articulos = (await getCollection('articulos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [destacado, ...resto] = articulos;
const categorias = [...new Set(articulos.map((a) => a.data.categoria))];
---

<BaseLayout
  title="Tutoriales de Docker, .NET, Angular y self-hosting en VPS"
  description="Tutoriales y comparativas técnicas sobre despliegue, Docker, .NET, Angular y self-hosting en VPS, escritos desde la experiencia real de mi propia infraestructura."
>
  <section class="mx-auto max-w-5xl px-6 pb-4 pt-16 md:pt-24">
    <p class="text-sm font-medium text-cyan-600 dark:text-cyan-400">Notas de un desarrollador que despliega sus propias cosas</p>
    <h1 class="mt-3 max-w-2xl text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-5xl">
      Docker, .NET, Angular y self-hosting en VPS
    </h1>
    <p class="mt-4 max-w-xl text-lg text-gray-600 dark:text-gray-400">
      Tutoriales y comparativas escritos desde mi propia infraestructura — con datos, capturas y precios reales, no
      copiados de otro blog.
    </p>

    {
      categorias.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {categorias.map((categoria) => (
            <span class="rounded-full border border-gray-200 px-3 py-1 text-xs font-medium text-gray-500 dark:border-gray-800 dark:text-gray-400">
              {categoryLabel(categoria)}
            </span>
          ))}
        </div>
      )
    }
  </section>

  {
    destacado && (
      <section class="mx-auto max-w-5xl px-6 pt-10">
        <ArticleCard articulo={destacado} featured />
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-6 pb-24 pt-10">
    {resto.length > 0 && <h2 class="mb-6 text-sm font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Más artículos</h2>}

    <div class="grid gap-5 sm:grid-cols-2">
      {resto.map((articulo) => (
        <ArticleCard articulo={articulo} />
      ))}
    </div>

    {articulos.length === 0 && <p class="text-gray-500 dark:text-gray-400">Todavía no hay artículos publicados — vuelve pronto.</p>}
  </section>
</BaseLayout>
