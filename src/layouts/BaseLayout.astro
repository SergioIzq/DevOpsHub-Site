---
import Navbar from '@/components/sections/Navbar.astro';
import SeoHead from '@/components/seo/SeoHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e7490" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="devops.sergioizq.com" href="/rss.xml" />
    <SeoHead title={title} description={description} canonicalPath={canonicalPath} />
    <slot name="head" />
    <script is:inline>
      // Se ejecuta antes del primer paint para evitar flash del tema incorrecto.
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>

  <body class="min-h-screen bg-white font-sans text-gray-900 antialiased dark:bg-gray-950 dark:text-gray-100">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-cyan-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>

    <header class="sticky top-0 z-40 border-b border-gray-200/80 bg-white/80 backdrop-blur-sm dark:border-gray-800/80 dark:bg-gray-950/80">
      <Navbar />
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="mt-24 border-t border-gray-200 dark:border-gray-800">
      <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-gray-500 dark:text-gray-400">
        <p>© {new Date().getFullYear()} Sergio Izquierdo — tutoriales de Docker, .NET, Angular y self-hosting en VPS.</p>
        <p class="mt-1">
          Algunos enlaces son de afiliado: si compras a través de ellos, este sitio recibe una pequeña comisión sin
          coste extra para ti.
        </p>
      </div>
    </footer>
  </body>
</html>
